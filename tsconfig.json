{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "types/database.types.ts",
    "docs/javascripts/auth-manager.js",
    "docs/javascripts/knowledge-store.js",
    "docs/javascripts/museum-admin.js",
    "docs/javascripts/wiki-enhancements.js",
    "docs/javascripts/timeline-interactive.js",
    "docs/javascripts/entry-search.js",
    "docs/javascripts/network-explorer.js",
    "docs/javascripts/museum.js",
    "docs/javascripts/museum-images.js",
    "docs/javascripts/technology-tree.js",
    "docs/javascripts/global-network.js"
  ]
}